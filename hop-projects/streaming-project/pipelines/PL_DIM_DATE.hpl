    <name>INSERT_UPDATE_TO_DIM_DATE</name>
    <lookup>
      <key>
        <name>tanggal</name>
        <field>tanggal</field>
        <condition>=</condition>
        <name2/>
      </key>
      <value>
        <name>tanggal</name>
        <rename>tanggal</rename>
        <update>N</update>
