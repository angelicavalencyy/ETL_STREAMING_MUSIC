  <transform>
    <type>TableInput</type>
    <name>FROM_TABLE_DATE</name>
    <sql>SELECT 
    tanggal,
    EXTRACT(DAY FROM tanggal)::INTEGER AS hari,
    EXTRACT(MONTH FROM tanggal)::INTEGER AS bulan,
    TO_CHAR(tanggal, 'TMMonth') AS nama_bulan,
    EXTRACT(QUARTER FROM tanggal)::INTEGER AS kuartal,
    EXTRACT(YEAR FROM tanggal)::INTEGER AS tahun
FROM (
    SELECT DISTINCT tanggal
    FROM (
        SELECT activity_date AS tanggal FROM user_activity
        UNION
        SELECT tanggal_bayar FROM payments
        UNION
        SELECT mulai FROM subscriptions
        UNION
        SELECT berakhir FROM subscriptions
        UNION
        SELECT tanggal_rilis FROM albums
        UNION
        SELECT tanggal_follow FROM artist_followers
    ) AS dates
    WHERE tanggal IS NOT NULL
) AS d;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>SOURCE_STREAMING_MUSIC</connection>
    <lookup/>
    <sql_from_file/>
    <use_named_parameters>Y</use_named_parameters>
    <specify_fields>N</specify_fields>
    <validate_specified_fields>N</validate_specified_fields>
