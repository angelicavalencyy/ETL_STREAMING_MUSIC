    ai.user_id,
    ai.ad_id,
    ai.device_id,
    ai.waktu_tayang,
    1 AS jumlah_tayang,
    CASE WHEN ai.is_click THEN 1 ELSE 0 END AS jumlah_klik
FROM ad_impressions ai;</sql>
