  <transform>
    <type>TableInput</type>
    <name>FROM_USER_ACTIVITY</name>
    <sql>SELECT
    activity_id,
    user_id,
    activity_date,
    activity_type,
    session_id,
    waktu_mulai,
    waktu_selesai,
    EXTRACT(
        EPOCH FROM (waktu_selesai - waktu_mulai)
    )::INTEGER AS durasi_detik
FROM user_activity
WHERE waktu_mulai IS NOT NULL
  AND waktu_selesai IS NOT NULL
  AND waktu_selesai >= waktu_mulai;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
